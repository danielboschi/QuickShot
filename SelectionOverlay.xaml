<Window x:Class="QuickShot.SelectionOverlay" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Background="Black" RenderOptions.BitmapScalingMode="NearestNeighbor" PreviewKeyDown="OnPreviewKeyDown" MouseLeftButtonDown="OnMouseDown" MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseUp" LostMouseCapture="OnLostMouseCapture">
  <Window.Resources>
    <SolidColorBrush x:Key="ToolbarBackground" Color="#F51F2128" />
    <SolidColorBrush x:Key="ToolbarBorder" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="ToolbarForeground" Color="#E8EAF0" />
    <SolidColorBrush x:Key="ToolbarMuted" Color="#A9AFBD" />
    <SolidColorBrush x:Key="ToolbarHover" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="ToolbarPressed" Color="#3AFFFFFF" />
    <SolidColorBrush x:Key="ToolbarAccent" Color="#4F6BF5" />

    <Style x:Key="ToolbarFocus">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate><Rectangle Margin="1" RadiusX="7" RadiusY="7" Stroke="White" StrokeThickness="1.5" /></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Ações: desfazer, refazer, salvar -->
    <Style x:Key="ToolbarButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Margin" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{StaticResource ToolbarForeground}" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource ToolbarFocus}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border CornerRadius="8" Background="{TemplateBinding Background}" />
              <Border x:Name="Back" CornerRadius="8" Background="Transparent">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Back" Property="Background" Value="{StaticResource ToolbarHover}" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Back" Property="Background" Value="{StaticResource ToolbarPressed}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Ação principal: copiar -->
    <Style x:Key="ToolbarPrimary" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
      <Setter Property="Background" Value="{StaticResource ToolbarAccent}" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Ferramentas: a ativa fica destacada -->
    <Style x:Key="ToolbarTool" TargetType="RadioButton">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Margin" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{StaticResource ToolbarForeground}" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource ToolbarFocus}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Back" CornerRadius="8" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Back" Property="Background" Value="{StaticResource ToolbarHover}" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Back" Property="Background" Value="{StaticResource ToolbarPressed}" /></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{StaticResource ToolbarAccent}" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Cores: a amostra vem de Background; a ativa ganha um anel -->
    <Style x:Key="ToolbarColor" TargetType="RadioButton">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource ToolbarFocus}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Background="Transparent">
              <Ellipse x:Name="Ring" Width="24" Height="24" Stroke="White" StrokeThickness="2" Visibility="Hidden" />
              <Ellipse x:Name="Swatch" Width="16" Height="16" Fill="{TemplateBinding Background}" Stroke="#66FFFFFF" StrokeThickness="1" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Swatch" Property="Width" Value="18" /><Setter TargetName="Swatch" Property="Height" Value="18" /></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Espessura -->
    <Style x:Key="ToolbarSliderPart" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Grid Background="Transparent"><Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" /></Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ToolbarSlider" TargetType="Slider">
      <Setter Property="Height" Value="34" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource ToolbarFocus}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource ToolbarSliderPart}" Background="{StaticResource ToolbarAccent}" /></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource ToolbarSliderPart}" Background="#4DFFFFFF" /></Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="14" Height="34">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Ellipse Width="14" Height="14" Fill="White" /></Grid></ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Alças de ajuste da seleção: a área sensível é maior que o ponto visível -->
    <Style x:Key="ResizeGrip" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Grid Background="Transparent">
              <Ellipse x:Name="Dot" Width="9" Height="9" Fill="{TemplateBinding Foreground}" StrokeThickness="1.5" Stroke="{StaticResource ToolbarAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Foreground" Value="Transparent"><Setter TargetName="Dot" Property="Visibility" Value="Hidden" /></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Dot" Property="Fill" Value="{StaticResource ToolbarAccent}" /></Trigger>
              <Trigger Property="IsDragging" Value="True"><Setter TargetName="Dot" Property="Fill" Value="{StaticResource ToolbarAccent}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Canvas x:Name="Surface" Cursor="Cross" Background="#88000000">
    <Image x:Name="Bright" Stretch="Fill" Visibility="Collapsed" IsHitTestVisible="False" />
    <Rectangle x:Name="SelectionShadow" Stroke="#CC111111" StrokeThickness="3" StrokeDashArray="2,2" StrokeDashCap="Flat" Fill="Transparent" Visibility="Collapsed" IsHitTestVisible="False" />
    <Rectangle x:Name="Selection" Stroke="White" StrokeThickness="1.5" StrokeDashArray="2,2" StrokeDashCap="Flat" Fill="Transparent" Visibility="Collapsed" IsHitTestVisible="False" />
    <Border x:Name="SizeLabel" Background="#D91F2128" CornerRadius="5" Padding="7,3" Visibility="Collapsed" IsHitTestVisible="False">
      <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" />
    </Border>
    <Border x:Name="Hint" Background="#D91F2128" CornerRadius="8" Padding="12,8" IsHitTestVisible="False">
      <TextBlock Text="Arraste para selecionar · Clique para capturar a janela · R repete a última região · Esc cancela" Foreground="White" FontSize="14" />
    </Border>
  </Canvas>
</Window>