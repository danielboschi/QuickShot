<Window x:Class="QuickShot.SelectionOverlay" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" AllowsTransparency="True" Background="#88000000" PreviewKeyDown="OnPreviewKeyDown" MouseLeftButtonDown="OnMouseDown" MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseUp">
  <Canvas x:Name="Surface" Cursor="Cross" >
    <Rectangle x:Name="SelectionShadow" Stroke="#CC111111" StrokeThickness="3" StrokeDashArray="2,2" StrokeDashCap="Flat" Fill="Transparent" Visibility="Collapsed" IsHitTestVisible="False" />
    <Rectangle x:Name="Selection" Stroke="White" StrokeThickness="1.5" StrokeDashArray="2,2" StrokeDashCap="Flat" Fill="#1800AEEF" Visibility="Collapsed" IsHitTestVisible="False" />
    <TextBlock x:Name="Hint" Text="Arraste para selecionar uma área · Esc para cancelar" Foreground="White" FontSize="16" Canvas.Left="18" Canvas.Top="18" />
  </Canvas>
</Window>
