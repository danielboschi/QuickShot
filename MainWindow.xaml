<Window x:Class="QuickShot.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:QuickShot"
        Title="QuickShot" Width="1050" Height="760" MinWidth="700" MinHeight="500" Background="#202124" KeyDown="OnKeyDown">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#303134" Padding="10">
      <WrapPanel VerticalAlignment="Center">
        <Button Content="Caneta" Tag="Pen" Click="ToolClick" Margin="2" />
        <Button Content="Linha" Tag="Line" Click="ToolClick" Margin="2" />
        <Button Content="Seta" Tag="Arrow" Click="ToolClick" Margin="2" />
        <Button Content="Retângulo" Tag="Rectangle" Click="ToolClick" Margin="2" />
        <Button Content="Elipse" Tag="Ellipse" Click="ToolClick" Margin="2" />
        <Button Content="Texto" Tag="Text" Click="ToolClick" Margin="2" />
        <Button Content="Marca-texto" Tag="Highlight" Click="ToolClick" Margin="2" />
        <Button Content="Borracha" Tag="Erase" Click="ToolClick" Margin="2" />
        <Separator Width="12" />
        <Button Content="↶" ToolTip="Desfazer" Click="UndoClick" Margin="2" />
        <Button Content="↷" ToolTip="Refazer" Click="RedoClick" Margin="2" />
        <TextBlock Text="  Cor:" Foreground="White" VerticalAlignment="Center" />
        <ComboBox x:Name="ColorBox" Width="100" SelectedIndex="0" SelectionChanged="ColorChanged" Margin="4,2"><ComboBoxItem Content="Vermelho" Tag="#E53935"/><ComboBoxItem Content="Azul" Tag="#1E88E5"/><ComboBoxItem Content="Verde" Tag="#43A047"/><ComboBoxItem Content="Preto" Tag="#111111"/><ComboBoxItem Content="Branco" Tag="#FFFFFF"/></ComboBox>
        <TextBlock Text="Espessura:" Foreground="White" VerticalAlignment="Center" />
        <Slider x:Name="Thickness" Minimum="1" Maximum="24" Value="3" Width="100" Margin="4,2" ValueChanged="ThicknessChanged" />
        <CheckBox x:Name="CtrlPrint" Content="Ctrl+Print Screen" Foreground="White" Margin="14,2" Checked="ShortcutChanged" Unchecked="ShortcutChanged" />
        <Button Content="Copiar PNG (Ctrl+C)" Click="CopyClick" Margin="8,2" />
      </WrapPanel>
    </Border>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#151515">
      <local:DrawingSurface x:Name="Editor" HorizontalAlignment="Left" VerticalAlignment="Top" />
    </ScrollViewer>
  </DockPanel>
</Window>
